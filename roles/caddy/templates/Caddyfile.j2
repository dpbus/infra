{
	email {{ caddy_email }}
}

*.{{ caddy_domain }} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}
{% for service in caddy_services %}

	@{{ service.name }} host {{ service.name }}.{{ caddy_domain }}
	handle @{{ service.name }} {
{% if service.insecure_tls | default(false) %}
		reverse_proxy {{ service.upstream }} {
			transport http {
				tls_insecure_skip_verify
			}
		}
{% else %}
		reverse_proxy {{ service.upstream }}
{% endif %}
	}
{% endfor %}

	handle {
		abort
	}
}
